# Postgres connection string (Railway/Render give you this after provisioning a DB)
DATABASE_URL=

# Same database, but its DIRECT (non-pooled) connection string - required by
# Prisma migrations specifically (pooled/PgBouncer connections can't hold the
# advisory lock migrate needs). On Neon: Connect > toggle "Connection pooling"
# off > copy that string. Only used at migration/build time, not at runtime.
DIRECT_URL=

# Random long string used to encrypt stored tokens/cookies at rest and to sign
# the dashboard session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Password to log into the web dashboard (single-user gate, not a real user system)
DASHBOARD_PASSWORD=

# Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web application)
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# From @BotFather in Telegram (see README for step-by-step)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Random string only Telegram and this app know, so /api/telegram/webhook
# (a public route - it has to be, Telegram calls it) can verify a request
# genuinely came from Telegram and not some random POST to a guessed URL.
# Generate one with the same command as APP_ENCRYPTION_KEY above, then
# register it with Telegram - see README's "Two-way bot" setup section.
TELEGRAM_WEBHOOK_SECRET=

# Hour (0-23, server local time) the daily digest is allowed to send
DIGEST_HOUR=8

# Optional. Minutes between repeat Telegram nags for a deadline/task marked
# "urgent" once it's overdue and hasn't been Accepted/Done/snoozed/muted.
# Defaults to 15 if unset. Can't usefully go below how often the worker
# actually runs (every 10 min - see .github/workflows/worker.yml).
NAG_INTERVAL_MINUTES=15

# The Google Sheet used for the Tasks tab (and later Scorebuddy tab)
# Copy the ID out of the sheet's URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEETS_SPREADSHEET_ID=

# Vercel dashboard > your project > Storage > Create Database > Blob
# Only needed for the optional deadline photo attachment; Vercel adds this
# automatically once a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
