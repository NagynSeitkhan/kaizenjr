{
  "name": "course-dashboard",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "dotenv -e .env -- npm run dev --workspace=apps/web",
    "dev:worker": "dotenv -e .env -- npm run dev --workspace=apps/worker",
    "build:web": "npm run build --workspace=apps/web",
    "build:worker": "npm run build --workspace=apps/worker",
    "db:generate": "dotenv -e .env -- npm run generate --workspace=packages/db",
    "db:migrate": "dotenv -e .env -- npm run migrate --workspace=packages/db",
    "moodle:login": "dotenv -e .env -- npm run login --workspace=apps/worker"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.2"
  }
}
